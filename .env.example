# =============================================================================
# tiktok-generator-video — variables d'environnement
# Copie ce fichier vers `.env` et remplis avec tes clés.
# =============================================================================

# Anthropic Claude API (génération de scripts)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs — multi-account fallback automatique sur quota épuisé.
# Le pipeline essaie ELEVENLABS_API_KEY_1, puis _2, puis _3, etc.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY_1=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY_2=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_API_KEY_3=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stock footage
# https://www.pexels.com/api/
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=xxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxx

# Remotion (parallélisme de rendu)
REMOTION_CONCURRENCY=4

# Output base (relatif au repo, ou absolu)
OUTPUT_DIR=./output

# TikTok Content Posting API — depuis developers.tiktok.com (app)
# Optionnel tant que l'auto-posting n'est pas activé.
TIKTOK_CLIENT_KEY=xxxxxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_REDIRECT_URI=https://www.gcn-data.fr/tiktok-callback.html
