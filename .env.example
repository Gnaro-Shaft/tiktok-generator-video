# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — multi-account fallback
ELEVENLABS_API_KEY_1=sk_...
ELEVENLABS_API_KEY_2=sk_...

# Stock footage
PEXELS_API_KEY=...
PIXABAY_API_KEY=...

# Remotion
REMOTION_CONCURRENCY=4

# Output base
OUTPUT_DIR=./output

# Higgsfield Seedance 2.5 — format : YOUR_KEY_ID:YOUR_KEY_SECRET
# Récupérer sur console.higgsfield.ai → API Keys
HF_KEY=
# Plafond de dépense par run (€) — Seedance 2.5 : 0.144 €/s en 720p
HIGGSFIELD_BUDGET_EUR=5.0

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REDIRECT_URI=https://www.gcn-data.fr/tiktok-callback.html
