<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tiktokgen.stats</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dgnaro/projects/10-en-cours/tiktok_generator-video/scheduler/run-stats.sh</string>
    </array>

    <!-- Tous les jours à 08:00 heure locale -->
    <key>StartCalendarInterval</key>
